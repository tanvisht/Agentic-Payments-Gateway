{
  "outputDirectory": "web",
  "cleanUrls": true,
  "functions": {
    "api/run.py": { "maxDuration": 20, "includeFiles": "agentpay/**" }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
